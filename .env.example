# ============================================================
# 复制为 .env 并填入真实值。.env 已被 gitignore，绝不提交仓库。
# 部署到 GitHub Actions 时，把同名变量配置为仓库 Secrets。
# ============================================================

# --- Supabase PostgreSQL（托管数据库） ---
# 后端直连用（连接池域名，事务模式 pooler 6543）
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# --- Cube.js 连接同一 PostgreSQL ---
# Cube.js 建议使用会话池（session pooler，端口 5432），避免事务池对预处理语句的限制
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=postgres
CUBEJS_DB_USER=postgres.PROJECT_REF
CUBEJS_DB_PASS=PASSWORD
CUBEJS_DB_SSL=true

# --- Cube.js ---
CUBEJS_API_SECRET=change_me_to_a_long_random_secret
CUBEJS_DEV_MODE=true

# --- DeepSeek LLM（OpenAI 兼容） ---
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
